# Conexão Postgres (Neon ou local via docker-compose)
DATABASE_URL=

# Segredo para assinar JWTs (qualquer string longa).
# Obrigatório: a aplicação não sobe sem ele.
JWT_SECRET=

# development | production
NODE_ENV=development

# Token do Vercel Blob (necessário só em produção, gerado no painel da Vercel
# em Storage → Blob → .env.local). Em dev, sem token, o upload usa disco local.
BLOB_READ_WRITE_TOKEN=

# ---- Resumo por IA (src/ai/) ----
# Roda dentro do próprio Nest — chama a Groq/Gemini direto pela API REST, sem
# depender do ai-service/ em Python nem de um segundo deploy.

# Provedor usado quando o pedido não escolhe outro: groq | gemini
LLM_PROVIDER=groq

# ---- Groq — https://console.groq.com/keys ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
# Plano gratuito: 8000 tokens/minuto contando entrada + este teto.
GROQ_MAX_TOKENS=4000
# low | medium | high. Mais = mais lento e mais tokens.
GROQ_REASONING_EFFORT=low

# ---- Gemini — https://aistudio.google.com/apikey (alternativa à Groq) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=8192

# Quanto esperar a Groq/Gemini responder (costuma levar 5-30s).
AI_TIMEOUT_MS=120000

# ---- reCAPTCHA (login e cadastro) ----
# Chave SECRETA do reCAPTCHA (https://www.google.com/recaptcha/admin).
# A chave do site (pública) fica no front, não aqui.
# Vazio = verificacao DESATIVADA, com aviso no log. Em NODE_ENV=production
# a ausencia passa a ser erro (503) em vez de bypass.
RECAPTCHA_SECRET=

# Score minimo aceito na v3 (0 a 1). Ignorado na v2, que nao devolve score.
RECAPTCHA_MIN_SCORE=0.5

# Tempo maximo esperando o siteverify do Google.
RECAPTCHA_TIMEOUT_MS=8000
